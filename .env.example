APP_NAME=SkillOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skillos
DB_USERNAME=skillos
DB_PASSWORD=skillos
# SQLite also works, no server needed:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Legacy second model, used only when the chain lists below are empty.
GEMINI_FALLBACK_MODEL=
# Ordered model chains, best first (comma separated; "model:level" sets a thinking level).
# Empty = GEMINI_MODEL + GEMINI_FALLBACK_MODEL. Quota is per model, so keep the first
# entries of the two lists different.
GEMINI_JUDGE_MODELS=
GEMINI_GENERATE_MODELS=
# A learner never waits long: seconds per attempt, models tried per request, total seconds.
GEMINI_ATTEMPT_TIMEOUT=10
GEMINI_MAX_ATTEMPTS=3
GEMINI_TOTAL_BUDGET=20

# Optional — routes the Gemini call through the shared HTTP relay instead of
# connecting directly, for when this server can't reach Google itself (Iran-
# hosted production is blocked at Google's own edge). Production uses
# https://relay.growwise.ir (shared with English OS); AI_PROXY_SECRET is the
# shared relay secret and goes only in the production .env. Left blank, every
# call connects directly.
AI_PROXY_URL=
AI_PROXY_SECRET=
