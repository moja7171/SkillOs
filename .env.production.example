# Copy to skillos/.env on the host (once). Never overwritten by later releases.
APP_NAME=SkillOS
APP_ENV=production
APP_KEY=                      # paste the output of `php artisan key:generate --show` from your machine
APP_DEBUG=false
APP_URL=https://example.com
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_DATABASE=/home/USER/skillos/database/database.sqlite   # default: skillos/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=10080
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Course media served from your own machine (tools/media-server.py). Leave empty
# if the files live on the host under public_html/media/.
MEDIA_BASE_URL=http://localhost:8765

# Long random string. Enables /_ops/{status,migrate,import,optimize,clear}?token=...
OPS_TOKEN=
# Optional invite code required on the register page.
REGISTRATION_CODE=
